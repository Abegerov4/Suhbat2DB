# Шаблон переменных окружения Suhbat2DB.
# Локальный .env с случайными секретами создаёт: make env
# Значения с пометкой <generated> заполняются скриптом scripts/init-env.sh.

# --- Приложение ---
APP_ENV=dev
JWT_SECRET=<generated>
# ключ Fernet для шифрования строк подключения к БД пользователей
APP_ENCRYPTION_KEY=<generated>
# первый администратор платформы (создаётся при старте backend)
ADMIN_EMAIL=admin@suhbat2db.kz
ADMIN_PASSWORD=<generated>

# --- БД приложения (app-db) ---
APP_DB_USER=app
APP_DB_PASSWORD=<generated>
APP_DB_NAME=app
APP_DB_PORT=5442            # порт на хосте (5432 часто занят локальным Postgres)

# --- Целевая демо-БД (target-db) ---
TARGET_DB_ADMIN_USER=target_admin
TARGET_DB_ADMIN_PASSWORD=<generated>
TARGET_DB_NAME=demo
TARGET_DB_PORT=5443
# Роль только для чтения, под которой агент выполняет SQL
TARGET_DB_READER_USER=s2d_reader
TARGET_DB_READER_PASSWORD=<generated>

# --- LLM ---
LLM_PRIMARY_PROVIDER=openai       # openai | anthropic
LLM_FALLBACK_PROVIDER=anthropic   # используется, только если задан его ключ
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Лимиты выполнения SQL ---
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=1000
SQL_MAX_EXPLAIN_COST=1000000
AGENT_MAX_CORRECTIONS=3

# --- Порты на хосте (поменяйте, если заняты) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Langfuse: трассировка backend ---
# По умолчанию Langfuse Cloud: ключи проекта из https://cloud.langfuse.com (Settings → API Keys).
# Если ключи пустые, трассировка отключена. Для локального Langfuse (make up-langfuse)
# укажите LANGFUSE_BASE_URL=http://langfuse-web:3000 и ключи LANGFUSE_LOCAL_*.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Локальный Langfuse (необязательно: make up-langfuse, UI http://localhost:3001) ---
# Ключи локального проекта создаются при первом запуске локального Langfuse.
LANGFUSE_LOCAL_PUBLIC_KEY=<generated>
LANGFUSE_LOCAL_SECRET_KEY=<generated>
LANGFUSE_INIT_USER_EMAIL=admin@suhbat2db.local
LANGFUSE_INIT_USER_PASSWORD=<generated>
LANGFUSE_NEXTAUTH_SECRET=<generated>
LANGFUSE_SALT=<generated>
LANGFUSE_ENCRYPTION_KEY=<generated>
LANGFUSE_DB_PASSWORD=<generated>
LANGFUSE_CLICKHOUSE_PASSWORD=<generated>
LANGFUSE_REDIS_PASSWORD=<generated>
LANGFUSE_MINIO_PASSWORD=<generated>
