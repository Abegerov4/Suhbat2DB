%% System context diagram (C4, level 1)
flowchart TB
    analyst["👤 Analyst<br/><i>asks questions about data<br/>in natural language</i>"]
    admin["👤 Administrator<br/><i>connects databases</i>"]

    system["<b>Suhbat2DB</b><br/>web platform for conversational data analysis:<br/>clarifies ambiguous questions,<br/>generates and validates SQL,<br/>explains and visualises the result"]

    target[("Analysed database<br/>PostgreSQL<br/><i>read-only role</i>")]
    llm["LLM provider<br/>OpenAI API<br/><i>generation, classification,<br/>embeddings</i>"]
    langfuse["Langfuse Cloud<br/><i>traces, cost,<br/>prompt versions</i>"]

    analyst -->|"questions, clarification answers,<br/>answer ratings (HTTPS)"| system
    admin -->|"data source registration"| system
    system -->|"SELECT in a read-only transaction,<br/>schema introspection"| target
    system -->|"prompts with the linked schema"| llm
    system -.->|"traces of every turn"| langfuse

    classDef person fill:#e8f1ff,stroke:#3b6fd8,color:#0b2a5b
    classDef sys fill:#3b6fd8,stroke:#1f4aa8,color:#ffffff
    classDef ext fill:#f2f2f2,stroke:#888888,color:#222222
    class analyst,admin person
    class system sys
    class target,llm,langfuse ext
